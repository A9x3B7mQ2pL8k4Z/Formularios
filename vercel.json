{
  "version": 2,
  "builds": [
    {
      "src": "server.py",
      "use": "@vercel/python",
      "config": {
        "maxDuration": 30,
        "includeFiles": [
          "app/backend/**",
          "app/frontend/templates/**"
        ],
        "excludeFiles": ["tests/**", ".env", ".env.*", ".venv/**", "**/__pycache__/**"]
      }
    },
    {
      "src": "app/frontend/static/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    { "src": "/static/(.*)", "dest": "/app/frontend/static/$1" },
    { "src": "/(.*)", "dest": "server.py" }
  ]
}
